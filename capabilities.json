          "displayName": "Sort Order",
          "type": {
            "enumeration": [
              { "displayName": "Auto (Power BI)", "value": "auto" },
              { "displayName": "Ascending",       "value": "asc"  },
              { "displayName": "Descending",      "value": "desc" }
            ]
          }
        },
        "showXLabels":  { "displayName": "Show X Labels",  "type": { "bool": true } },
        "showYLabels":  { "displayName": "Show Y Labels",  "type": { "bool": true } },
        "xFontSize":    { "displayName": "X Label Size",   "type": { "formatting": { "fontSize": true } } },
        "yFontSize":    { "displayName": "Y Label Size",   "type": { "formatting": { "fontSize": true } } }
      }
    },
    "panelStyle": {
      "displayName": "Panel Background",
      "properties": {
        "showBackground": { "displayName": "Show Background", "type": { "bool": true } },
        "bgColor": {
