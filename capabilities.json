    "legend": {
      "displayName": "Legend",
      "properties": {
        "show": {
          "displayName": "Show",
          "type": { "bool": true }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": [
              { "displayName": "Top", "value": "top" },
              { "displayName": "Bottom", "value": "bottom" }
            ]
          }
        },
        "textColor": {
          "displayName": "Text Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "accessibility": {
      "displayName": "Accessibility",
      "properties": {
        "highContrastMode": {
          "displayName": "High contrast (pattern for negatives)",
          "type": { "bool": true }
        }
      }
    }
  },
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "bind": {
                  "to": "measure"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 100
              }
            }
          }
        }
      }
    }
  ],
  "privileges": [],
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": ["tooltips"]
  },
  "supportsHighlight": true,
  "supportsSynchronizingFilterState": true,
  "supportsLandingPage": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true
}