          "type": { "fill": { "solid": { "color": true } } }
        },
        "bgOpacity": { "displayName": "Opacity (%)", "type": { "numeric": true } }
      }
    },
    "panelLayout": {
      "displayName": "Panel Layout",
      "properties": {
