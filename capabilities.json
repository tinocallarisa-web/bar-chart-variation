  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "bind": {
                  "to": "measure"
                }
              },
              {
                "bind": {
                  "to": "previousYear"
                }
              },
              {
                "bind": {
                  "to": "plan"
                }
              },
              {
                "bind": {
                  "to": "forecast"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 100
              }
            }
          }
        }
      }
    }
  ],
  "privileges": [],
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": ["tooltips"]
  },
  "supportsHighlight": true,
  "supportsSynchronizingFilterState": true,
  "supportsLandingPage": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true
}