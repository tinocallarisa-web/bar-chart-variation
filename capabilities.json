        "enableScroll": {
          "displayName": "Enable Scroll",
          "type": { "bool": true }
        },
        "barBorderRadius": {
          "displayName": "Bar Corner Radius",
          "type": { "numeric": true }
        }
      }
    },
    "analyticalLines": {
      "displayName": "Analytical Lines (Pro)",
      "properties": {
        "showAverage": { "displayName": "Show Average", "type": { "bool": true } },
        "showMax":     { "displayName": "Show Max",     "type": { "bool": true } },
        "showMin":     { "displayName": "Show Min",     "type": { "bool": true } },
