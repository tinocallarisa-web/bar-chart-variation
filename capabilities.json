              { "displayName": "Solid",  "value": "solid" },
              { "displayName": "Dashed", "value": "dashed" },
              { "displayName": "Dotted", "value": "dotted" }
            ]
          }
        },
        "showLabel":  { "displayName": "Show Label",   "type": { "bool": true } },
        "labelSize":  { "displayName": "Label Size",   "type": { "numeric": true } },
        "showBand":   { "displayName": "Show Band",    "type": { "bool": true } },
        "bandMin": {
          "displayName": "Band Min",
          "type": { "numeric": true }
        },
        "bandMax": {
          "displayName": "Band Max",
          "type": { "numeric": true }
        },
        "bandColor": {
          "displayName": "Band Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "bandOpacity": { "displayName": "Band Opacity (%)", "type": { "numeric": true } }
      }
